# Manus 信源与正文加工配置示例（复制为 .env 本地使用；CI 用 Secrets/Variables）
# 真实 .env 已被 .gitignore 忽略，本文件不含任何真实密钥。

# ---- Manus 采集（fetch-manus.yml / scripts/manus_source/）----
MANUS_API_KEY=your-manus-api-key
# agent profile：manus-1.6-lite | manus-1.6 | manus-1.6-max
MANUS_AGENT_PROFILE=manus-1.6
# 轮询与总超时（秒）
MANUS_POLL_SECONDS=10
MANUS_TIMEOUT_SECONDS=3600
MANUS_REGISTER_GRACE_SECONDS=90
# 正文阶段：每批最多 4 篇；并发不突破账户限额
MANUS_CONTENT_BATCH_SIZE=4
MANUS_CONTENT_CONCURRENCY=2
# 每篇正文返回上限与本地最小长度门槛（字符）
MANUS_MAX_CONTENT_CHARS=20000
MANUS_MIN_CONTENT_CHARS=100

# ---- 正文加工模型（enrich_news.py，OpenAI-compatible）----
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：覆盖默认 https://api.deepseek.com（CI 用 repository variable LLM_API_BASE）
# LLM_API_BASE=https://api.deepseek.com
# 可选：覆盖 taxonomy.json 的 model（改用 DeepSeek 之外的其他 OpenAI 兼容模型）
# LLM_MODEL=deepseek-chat

# ---- 本地设置页（可选）----
# Next.js 设置页「保存到本地」会调用本服务写入 .env（见 scripts/settings-server.mjs）
# AIHOT_SETTINGS_PORT=9731
